{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dataworkbench.invalid/schemas/dsc/v1/assertion.schema.json",
  "title": "Dataset Structure Assertion v1 payload",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "artifact_type", "assertion_id", "context_version", "snapshot", "subject", "predicate", "instance_key", "multiplicity", "claims", "evidence", "conflicts", "resolution", "dependency_fingerprint", "sensitivity"],
  "properties": {
    "schema_version": {"const": 1}, "artifact_type": {"const": "dataset_structure_assertion"}, "assertion_id": {"$ref": "common.schema.json#/$defs/assertion_id"}, "context_version": {"const": "1"}, "snapshot": {"$ref": "common.schema.json#/$defs/snapshot"}, "subject": {"$ref": "common.schema.json#/$defs/subject"}, "predicate": {"enum": ["table.physical/schema_column", "table.structure/dataset_form", "table.structure/entity_binding", "table.structure/row_grain", "table.temporal/temporal_binding", "table.temporal/observed_cadence", "relationship.declared/relationship"]}, "instance_key": {"type": "string", "minLength": 1, "maxLength": 512}, "multiplicity": {"enum": ["single", "keyed_set"]}, "claims": {"type": "array", "items": {"$ref": "#/$defs/claim"}, "uniqueItems": true}, "evidence": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/evidence"}, "uniqueItems": true}, "conflicts": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/conflict"}, "uniqueItems": true}, "resolution": {"$ref": "#/$defs/resolution"}, "dependency_fingerprint": {"$ref": "common.schema.json#/$defs/sha256"}, "sensitivity": {"$ref": "common.schema.json#/$defs/sensitivity"}
  },
  "$defs": {
    "resolution": {"type": "object", "additionalProperties": false, "required": ["status", "effective_claim_ids", "reason_codes", "conflict_ids"], "properties": {"status": {"$ref": "common.schema.json#/$defs/resolution_status"}, "effective_claim_ids": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/claim_id"}, "uniqueItems": true}, "reason_codes": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/reason_code"}, "uniqueItems": true}, "conflict_ids": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/conflict_id"}, "uniqueItems": true}}, "allOf": [{"if": {"properties": {"status": {"enum": ["observed", "proposed", "confirmed"]}}, "required": ["status"]}, "then": {"properties": {"effective_claim_ids": {"minItems": 1, "maxItems": 1}}}}, {"if": {"properties": {"status": {"enum": ["unknown", "not_applicable", "conflict"]}}, "required": ["status"]}, "then": {"properties": {"effective_claim_ids": {"maxItems": 0}}}}, {"if": {"properties": {"status": {"const": "conflict"}}, "required": ["status"]}, "then": {"properties": {"conflict_ids": {"minItems": 1}}}, "else": {"properties": {"conflict_ids": {"maxItems": 0}}}}, {"if": {"properties": {"status": {"const": "not_applicable"}}, "required": ["status"]}, "then": {"properties": {"reason_codes": {"contains": {"const": "DSC_R_NOT_APPLICABLE_CONFIRMED"}}}}}]},
    "decision": {"type": "object", "additionalProperties": false, "required": ["decision_id", "action", "scope"], "properties": {"decision_id": {"$ref": "common.schema.json#/$defs/opaque_id"}, "action": {"enum": ["confirm", "replace", "clear", "mark_not_applicable", "promote"]}, "scope": {"enum": ["source_confirmed_structural", "consumer_local"]}, "owner_id": {"$ref": "common.schema.json#/$defs/opaque_id"}, "promotion_of": {"$ref": "common.schema.json#/$defs/opaque_id"}}, "allOf": [{"if": {"properties": {"scope": {"const": "consumer_local"}}, "required": ["scope"]}, "then": {"required": ["owner_id"]}}, {"if": {"properties": {"action": {"const": "promote"}}, "required": ["action"]}, "then": {"required": ["promotion_of"], "properties": {"scope": {"const": "source_confirmed_structural"}}}, "else": {"not": {"required": ["promotion_of"]}}}]},
    "claim": {"type": "object", "additionalProperties": false, "required": ["claim_id", "authority", "value", "evidence_ids"], "properties": {"claim_id": {"$ref": "common.schema.json#/$defs/claim_id"}, "authority": {"$ref": "common.schema.json#/$defs/authority"}, "value": {"$ref": "#/$defs/value"}, "evidence_ids": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/evidence_id"}, "uniqueItems": true}, "decision": {"$ref": "#/$defs/decision"}, "algorithm": {"type": "object", "additionalProperties": false, "required": ["name", "version"], "properties": {"name": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}}}, "confidence": {"type": "number", "minimum": 0, "maximum": 1}}, "allOf": [{"if": {"properties": {"authority": {"const": "deterministic_inference"}}, "required": ["authority"]}, "then": {"required": ["algorithm", "confidence"]}, "else": {"not": {"anyOf": [{"required": ["algorithm"]}, {"required": ["confidence"]}]}}}, {"if": {"properties": {"authority": {"const": "consumer_local_decision"}}, "required": ["authority"]}, "then": {"required": ["decision"], "properties": {"decision": {"allOf": [{"$ref": "#/$defs/decision"}, {"properties": {"scope": {"const": "consumer_local"}}, "required": ["owner_id"]}]}}}}, {"if": {"properties": {"authority": {"const": "source_confirmed_structural"}}, "required": ["authority"]}, "then": {"required": ["decision"], "properties": {"decision": {"allOf": [{"$ref": "#/$defs/decision"}, {"properties": {"scope": {"const": "source_confirmed_structural"}}}]}}}, "else": {"not": {"properties": {"decision": {"properties": {"scope": {"const": "consumer_local"}}, "required": ["scope"]}}, "required": ["decision"]}}}]},
    "value": {"oneOf": [
      {"type": "object", "additionalProperties": false, "required": ["kind", "column", "data_type", "nullable"], "properties": {"kind": {"const": "schema_column"}, "column": {"$ref": "common.schema.json#/$defs/qualified_column"}, "data_type": {"type": "string", "minLength": 1}, "nullable": {"type": "boolean"}}},
      {"type": "object", "additionalProperties": false, "required": ["kind", "form"], "properties": {"kind": {"const": "dataset_form"}, "form": {"enum": ["cross_sectional", "panel", "event", "interval", "repeated_cross_section", "unclassified"]}}},
      {"type": "object", "additionalProperties": false, "required": ["kind", "columns"], "properties": {"kind": {"const": "entity_binding"}, "columns": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/qualified_column"}, "minItems": 1, "uniqueItems": true}}},
      {"type": "object", "additionalProperties": false, "required": ["kind", "key_columns"], "properties": {"kind": {"const": "row_grain"}, "key_columns": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/qualified_column"}, "minItems": 1, "uniqueItems": true}}},
      {"type": "object", "additionalProperties": false, "required": ["kind", "axis_id", "temporal_type", "columns", "precision", "calendar"], "properties": {"kind": {"const": "temporal_binding"}, "axis_id": {"type": "string", "minLength": 1}, "temporal_type": {"enum": ["date", "period", "instant", "interval"]}, "columns": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/qualified_column"}, "minItems": 1, "maxItems": 2, "uniqueItems": true}, "precision": {"enum": ["year", "quarter", "month", "day", "hour", "minute", "second", "millisecond", "microsecond", "unknown"]}, "timezone": {"type": "string", "minLength": 1}, "calendar": {"enum": ["gregorian", "other_declared", "unknown"]}, "grouping": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/qualified_column"}, "uniqueItems": true}}, "allOf": [{"if": {"properties": {"temporal_type": {"enum": ["date", "period"]}}, "required": ["temporal_type"]}, "then": {"not": {"required": ["timezone"]}}}, {"if": {"properties": {"temporal_type": {"const": "interval"}}, "required": ["temporal_type"]}, "then": {"properties": {"columns": {"minItems": 2, "maxItems": 2}}}, "else": {"properties": {"columns": {"minItems": 1, "maxItems": 1}}}}]},
      {"type": "object", "additionalProperties": false, "required": ["kind", "axis_id", "grouping", "cadence"], "properties": {"kind": {"const": "observed_cadence"}, "axis_id": {"type": "string", "minLength": 1}, "grouping": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/qualified_column"}, "minItems": 1, "maxItems": 1, "uniqueItems": true}, "cadence": {"enum": ["regular", "mixed", "irregular", "unknown"]}, "observed_interval_class": {"type": "object", "additionalProperties": false, "required": ["unit", "step"], "properties": {"unit": {"enum": ["day", "week", "month", "quarter", "year"]}, "step": {"type": "integer", "minimum": 1}}}}, "allOf": [{"if": {"properties": {"cadence": {"const": "regular"}}, "required": ["cadence"]}, "then": {"required": ["observed_interval_class"]}, "else": {"not": {"required": ["observed_interval_class"]}}}]},
      {"type": "object", "additionalProperties": false, "required": ["kind", "key_pairs", "direction", "cardinality", "null_policy", "declaration_basis"], "properties": {"kind": {"const": "relationship"}, "key_pairs": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["from", "to"], "properties": {"from": {"$ref": "common.schema.json#/$defs/qualified_column"}, "to": {"$ref": "common.schema.json#/$defs/qualified_column"}}}, "minItems": 1}, "direction": {"enum": ["from_references_to", "to_references_from", "undirected"]}, "cardinality": {"enum": ["one_to_one", "one_to_many", "many_to_one", "many_to_many", "unknown"]}, "null_policy": {"enum": ["nulls_never_match", "nulls_equal"]}, "declaration_basis": {"enum": ["source_constraint", "reviewed_declaration", "promoted_structural_decision"]}}}
    ]}
  }
}
