{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dataworkbench.invalid/schemas/dsc/v1/request.schema.json",
  "title": "Dataset Structure Context resolution request v1",
  "type": "object", "additionalProperties": false,
  "required": ["protocol_version", "supported_context_versions", "snapshot", "as_of", "tables", "selectors", "consumer_id"],
  "properties": {"protocol_version": {"const": "1"}, "supported_context_versions": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true, "contains": {"const": "1"}}, "snapshot": {"$ref": "common.schema.json#/$defs/snapshot"}, "as_of": {"const": "latest"}, "tables": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/table_name"}, "minItems": 1, "uniqueItems": true}, "selectors": {"type": "array", "items": {"$ref": "#/$defs/selector"}, "minItems": 1}, "consumer_id": {"$ref": "common.schema.json#/$defs/opaque_id"}},
  "$defs": {
    "selector": {"oneOf": [{"type": "object", "additionalProperties": false, "required": ["selector_id", "subject", "predicate", "requirement", "accepted_resolution_states"], "properties": {"selector_id": {"type": "string", "minLength": 1, "maxLength": 256}, "subject": {"type": "object", "additionalProperties": false, "required": ["kind", "table"], "properties": {"kind": {"const": "table"}, "table": {"$ref": "common.schema.json#/$defs/table_name"}}}, "predicate": {"enum": ["table.physical/schema_column", "table.structure/dataset_form", "table.structure/entity_binding", "table.structure/row_grain", "table.temporal/temporal_binding", "table.temporal/observed_cadence"]}, "requirement": {"enum": ["required", "advisory", "optional"]}, "accepted_resolution_states": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/resolution_status"}, "minItems": 1, "uniqueItems": true}}}, {"type": "object", "additionalProperties": false, "required": ["selector_id", "subject", "predicate", "requirement", "accepted_resolution_states"], "properties": {"selector_id": {"type": "string", "minLength": 1, "maxLength": 256}, "subject": {"type": "object", "additionalProperties": false, "required": ["kind", "from_table", "to_table"], "properties": {"kind": {"const": "relationship"}, "from_table": {"$ref": "common.schema.json#/$defs/table_name"}, "to_table": {"$ref": "common.schema.json#/$defs/table_name"}}}, "predicate": {"const": "relationship.declared/relationship"}, "requirement": {"enum": ["required", "advisory", "optional"]}, "accepted_resolution_states": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/resolution_status"}, "minItems": 1, "uniqueItems": true}}}, {"type": "object", "additionalProperties": false, "required": ["selector_id", "subject", "predicate", "requirement", "accepted_resolution_states"], "properties": {"selector_id": {"type": "string", "minLength": 1, "maxLength": 256}, "subject": {"$ref": "common.schema.json#/$defs/subject"}, "predicate": {"type": "string", "pattern": "^[a-z][a-z0-9_]*(?:[./][a-z][a-z0-9_]*)+$", "not": {"enum": ["table.physical/schema_column", "table.structure/dataset_form", "table.structure/entity_binding", "table.structure/row_grain", "table.temporal/temporal_binding", "table.temporal/observed_cadence", "relationship.declared/relationship"]}}, "requirement": {"enum": ["required", "advisory", "optional"]}, "accepted_resolution_states": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/resolution_status"}, "minItems": 1, "uniqueItems": true}}}]}
  }
}
