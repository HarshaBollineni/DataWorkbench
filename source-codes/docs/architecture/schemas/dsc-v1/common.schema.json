{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dataworkbench.invalid/schemas/dsc/v1/common.schema.json",
  "title": "Dataset Structure Context v1 common types",
  "type": "object", "additionalProperties": false, "properties": {},
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
    "opaque_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "artifact_id": {"type": "string", "pattern": "^art_[A-Za-z0-9_-]+$"},
    "assertion_id": {"type": "string", "pattern": "^dsca_[A-Za-z0-9_-]+$"},
    "claim_id": {"type": "string", "pattern": "^dscc_[A-Za-z0-9_-]+$"},
    "evidence_id": {"type": "string", "pattern": "^dsce_[A-Za-z0-9_-]+$"},
    "conflict_id": {"type": "string", "pattern": "^dscx_[A-Za-z0-9_-]+$"},
    "snapshot": {"type": "object", "additionalProperties": false, "required": ["asset_id", "snapshot_id"], "properties": {"asset_id": {"$ref": "#/$defs/opaque_id"}, "snapshot_id": {"$ref": "#/$defs/opaque_id"}}},
    "table_name": {"type": "string", "minLength": 1, "maxLength": 512},
    "column_name": {"type": "string", "minLength": 1, "maxLength": 512},
    "qualified_column": {"type": "object", "additionalProperties": false, "required": ["table", "column"], "properties": {"table": {"$ref": "#/$defs/table_name"}, "column": {"$ref": "#/$defs/column_name"}}},
    "subject": {"oneOf": [{"type": "object", "additionalProperties": false, "required": ["kind", "table"], "properties": {"kind": {"const": "table"}, "table": {"$ref": "#/$defs/table_name"}}}, {"type": "object", "additionalProperties": false, "required": ["kind", "from_table", "to_table"], "properties": {"kind": {"const": "relationship"}, "from_table": {"$ref": "#/$defs/table_name"}, "to_table": {"$ref": "#/$defs/table_name"}}}]},
    "resolution_status": {"enum": ["observed", "proposed", "confirmed", "conflict", "unknown", "not_applicable"]},
    "reuse_disposition": {"enum": ["fresh", "exact_reused", "reuse_candidate", "not_reusable"]},
    "sensitivity": {"enum": ["external_safe", "internal", "confidential"]},
    "authority": {"enum": ["verified_observation", "source_reviewed_metadata", "source_confirmed_structural", "consumer_local_decision", "deterministic_inference"]},
    "reason_code": {"enum": ["DSC_R_NO_EVIDENCE", "DSC_R_AMBIGUOUS_CANDIDATES", "DSC_R_INSUFFICIENT_BASIS", "DSC_R_STATE_NOT_ACCEPTED", "DSC_R_NOT_APPLICABLE_CONFIRMED", "DSC_R_DECISION_CLEARED", "DSC_R_RELATIONSHIP_UNDECLARED", "DSC_R_CONFLICT_DECLARED_OBSERVED", "DSC_R_CONFLICT_COMPETING_CONFIRMATIONS", "DSC_R_CONFLICT_RELATIONSHIP_ENDPOINT", "DSC_R_CONFLICT_TEMPORAL_INTERPRETATION", "DSC_R_DEPENDENCY_CHANGED", "DSC_R_SOURCE_MISSING", "DSC_R_SOURCE_INTEGRITY_FAILED", "DSC_R_EVIDENCE_FORBIDDEN", "DSC_R_UNSUPPORTED_FACET", "DSC_R_OPTIONAL_NOT_MATERIALIZED"]},
    "error_code": {"enum": ["DSC_E_INVALID_REQUEST", "DSC_E_PROTOCOL_VERSION_UNSUPPORTED", "DSC_E_CONTEXT_VERSION_NO_MATCH", "DSC_E_SELECTOR_SCOPE", "DSC_E_DUPLICATE_SELECTOR", "DSC_E_SNAPSHOT_MISMATCH", "DSC_E_CROSS_SNAPSHOT_UNSUPPORTED", "DSC_E_AS_OF_UNSUPPORTED", "DSC_E_TENANT_SCOPE"]},
    "source_ref": {"type": "object", "additionalProperties": false, "required": ["artifact_id", "role", "payload_hash"], "properties": {"artifact_id": {"$ref": "#/$defs/artifact_id"}, "role": {"enum": ["profile", "reviewed_metadata", "source_constraint", "decision", "scan", "dependency"]}, "payload_hash": {"$ref": "#/$defs/sha256"}}},
    "basis": {"type": "object", "additionalProperties": false, "required": ["population", "total_count", "exclusions", "usable_count", "computation"], "properties": {"population": {"type": "string", "minLength": 1, "maxLength": 256}, "total_count": {"type": "integer", "minimum": 0}, "exclusions": {"type": "object", "additionalProperties": false, "required": ["physical_null", "confirmed_special", "parse_failure"], "properties": {"physical_null": {"type": "integer", "minimum": 0}, "confirmed_special": {"type": "integer", "minimum": 0}, "parse_failure": {"type": "integer", "minimum": 0}}}, "usable_count": {"type": "integer", "minimum": 0}, "computation": {"enum": ["exact", "bounded_scan", "sampled"]}}},
    "measurement": {"oneOf": [{"type": "object", "additionalProperties": false, "required": ["name", "count"], "properties": {"name": {"type": "string", "minLength": 1}, "count": {"type": "integer", "minimum": 0}}}, {"type": "object", "additionalProperties": false, "required": ["name", "numerator", "denominator"], "properties": {"name": {"type": "string", "minLength": 1}, "numerator": {"type": "integer", "minimum": 0}, "denominator": {"type": "integer", "minimum": 1}}}]},
    "evidence": {"type": "object", "additionalProperties": false, "required": ["evidence_id", "kind", "source_refs", "basis", "measurements", "sensitivity"], "properties": {"evidence_id": {"$ref": "#/$defs/evidence_id"}, "kind": {"enum": ["physical_profile", "reviewed_metadata", "source_constraint", "structural_decision", "bounded_scan", "deterministic_inference"]}, "source_refs": {"type": "array", "items": {"$ref": "#/$defs/source_ref"}, "minItems": 1, "uniqueItems": true}, "basis": {"$ref": "#/$defs/basis"}, "measurements": {"type": "array", "items": {"$ref": "#/$defs/measurement"}, "uniqueItems": true}, "sensitivity": {"$ref": "#/$defs/sensitivity"}}},
    "conflict": {"type": "object", "additionalProperties": false, "required": ["conflict_id", "kind", "reason_code", "claim_ids", "evidence_ids"], "properties": {"conflict_id": {"$ref": "#/$defs/conflict_id"}, "kind": {"enum": ["declared_observed", "competing_confirmations", "relationship_endpoint", "temporal_interpretation"]}, "reason_code": {"enum": ["DSC_R_CONFLICT_DECLARED_OBSERVED", "DSC_R_CONFLICT_COMPETING_CONFIRMATIONS", "DSC_R_CONFLICT_RELATIONSHIP_ENDPOINT", "DSC_R_CONFLICT_TEMPORAL_INTERPRETATION"]}, "claim_ids": {"type": "array", "items": {"$ref": "#/$defs/claim_id"}, "minItems": 2, "uniqueItems": true}, "evidence_ids": {"type": "array", "items": {"$ref": "#/$defs/evidence_id"}, "minItems": 2, "uniqueItems": true}}, "allOf": [{"if": {"properties": {"kind": {"const": "declared_observed"}}, "required": ["kind"]}, "then": {"properties": {"reason_code": {"const": "DSC_R_CONFLICT_DECLARED_OBSERVED"}}}}, {"if": {"properties": {"kind": {"const": "competing_confirmations"}}, "required": ["kind"]}, "then": {"properties": {"reason_code": {"const": "DSC_R_CONFLICT_COMPETING_CONFIRMATIONS"}}}}, {"if": {"properties": {"kind": {"const": "relationship_endpoint"}}, "required": ["kind"]}, "then": {"properties": {"reason_code": {"const": "DSC_R_CONFLICT_RELATIONSHIP_ENDPOINT"}}}}, {"if": {"properties": {"kind": {"const": "temporal_interpretation"}}, "required": ["kind"]}, "then": {"properties": {"reason_code": {"const": "DSC_R_CONFLICT_TEMPORAL_INTERPRETATION"}}}}]}
  }
}
