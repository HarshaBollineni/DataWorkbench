{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dataworkbench.invalid/schemas/dsc/v2/request.schema.json",
  "title": "Dataset Structure Context resolution request with v2 negotiation",
  "type": "object", "additionalProperties": false,
  "required": ["protocol_version", "supported_context_versions", "snapshot", "as_of", "tables", "selectors", "consumer_id"],
  "properties": {"protocol_version": {"const": "1"}, "supported_context_versions": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true, "allOf": [{"contains": {"const": "2"}}, {"contains": {"const": "1"}}]}, "snapshot": {"$ref": "https://dataworkbench.invalid/schemas/dsc/v1/common.schema.json#/$defs/snapshot"}, "as_of": {"const": "latest"}, "tables": {"type": "array", "items": {"$ref": "https://dataworkbench.invalid/schemas/dsc/v1/common.schema.json#/$defs/table_name"}, "minItems": 1, "uniqueItems": true}, "consumer_id": {"$ref": "https://dataworkbench.invalid/schemas/dsc/v1/common.schema.json#/$defs/opaque_id"}, "selectors": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/selector"}}},
  "$defs": {"selector": {"type": "object", "additionalProperties": false, "required": ["selector_id", "subject", "predicate", "requirement", "accepted_resolution_states"], "properties": {"selector_id": {"type": "string", "minLength": 1, "maxLength": 256}, "subject": {"$ref": "https://dataworkbench.invalid/schemas/dsc/v1/common.schema.json#/$defs/subject"}, "predicate": {"enum": ["table.physical/schema_column", "table.structure/dataset_form", "table.structure/entity_binding", "table.structure/row_grain", "table.temporal/temporal_binding", "table.temporal/observed_cadence", "relationship.declared/relationship", "table.structure/default_entity_binding", "table.temporal/default_temporal_binding", "table.temporal/expected_cadence"]}, "requirement": {"enum": ["required", "advisory", "optional"]}, "accepted_resolution_states": {"type": "array", "items": {"$ref": "https://dataworkbench.invalid/schemas/dsc/v1/common.schema.json#/$defs/resolution_status"}, "minItems": 1, "uniqueItems": true}}}}
}
