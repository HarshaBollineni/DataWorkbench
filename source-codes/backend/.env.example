# Azure OpenAI configuration for DQ Studio AI layers.
# Copy to .env (keep .env out of version control) or `export` these before launching uvicorn.
AZURE_OPENAI_ENDPOINT=https://dna-model-validation.openai.azure.com/
AZURE_OPENAI_API_KEY=<your-azure-openai-key>
AZURE_OPENAI_DEPLOYMENT=gpt-4.1
AZURE_OPENAI_API_VERSION=2025-01-01-preview
